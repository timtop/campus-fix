{
  "name": "campusfix",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "postinstall": "prisma generate && nuxt prepare",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "nuxt typecheck",
    "db:deploy": "node --env-file-if-exists=.env scripts/init-db.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.8.2",
    "bcryptjs": "3.0.2",
    "nuxt": "4.6.4",
    "vue": "3.5.45",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.4.6",
    "autoprefixer": "10.4.21",
    "happy-dom": "21.0.4",
    "postcss": "8.5.23",
    "prisma": "6.8.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vite": "^8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "2.2.10"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "packageManager": "pnpm@10.11.0"
}
