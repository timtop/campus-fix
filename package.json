{
  "name": "campusfix",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "start": "wrangler dev",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "nuxt typecheck",
    "preview": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "seed:local": "node --env-file-if-exists=.dev.vars --import tsx scripts/seed-d1.ts --local",
    "seed:remote": "node --import tsx scripts/seed-d1.ts --remote",
    "setup:local": "node scripts/create-local-secret.mjs && pnpm db:local"
  },
  "dependencies": {
    "nuxt": "4.6.4",
    "vue": "3.5.45",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.4.6",
    "autoprefixer": "10.4.21",
    "happy-dom": "21.0.4",
    "postcss": "8.5.23",
    "prisma": "6.8.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vite": "^8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "2.2.10",
    "wrangler": "^4.162.0"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "packageManager": "pnpm@10.11.0"
}
